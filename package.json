{
  "name": "kenzo-infosystems-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Kenzo Infosystems ERP & Business Management System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "api:dev": "npm run start:dev --workspace @kenzo-erp/api",
    "api:build": "npm run build --workspace @kenzo-erp/api",
    "api:test": "npm run test --workspace @kenzo-erp/api",
    "web:dev": "npm run dev --workspace @kenzo-erp/web",
    "web:build": "npm run build --workspace @kenzo-erp/web",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only -P backend/tsconfig.json database/seeds/seed.ts",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma",
    "dev": "concurrently -n api,web -c blue,green \"npm run api:dev\" \"npm run web:dev\"",
    "db:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "build": "npm run api:build",
    "start": "node backend/dist/main.js",
    "render:build": "npm run db:deploy && npm run db:generate && npm run db:seed && npm run api:build",
    "render:start": "node backend/dist/main.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
