{
  "name": "kenzo-infosystems-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Kenzo Infosystems ERP & Business Management System",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "api:dev": "npm run start:dev --workspace @kenzo-erp/api",
    "api:build": "npm run build --workspace @kenzo-erp/api",
    "api:test": "npm run test --workspace @kenzo-erp/api",
    "web:dev": "npm run dev --workspace @kenzo-erp/web",
    "web:build": "npm run build --workspace @kenzo-erp/web",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only -P apps/api/tsconfig.json apps/api/prisma/seed.ts",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "dev": "concurrently -n api,web -c blue,green \"npm run api:dev\" \"npm run web:dev\"",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
