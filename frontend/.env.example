# Kenzo Infosystems web app (Next.js) - environment template.
# Locally the web app also reads the root .env; on a server, set these in
# the environment of the process that runs `next build` and `next start`.

# API base URL, including /api/v1 and with no trailing slash.
# Baked in at BUILD time: changing it requires a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Must match the API's BUSINESS_TIMEZONE.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kolkata

# Optional. Same value as the API's INTERNAL_PROXY_TOKEN (min 32 chars).
# When set, the browser's IP is forwarded to the API for audit logs and rate
# limits. Server-only: never prefix with NEXT_PUBLIC_.
# INTERNAL_PROXY_TOKEN=
# Number of reverse proxies in front of the web app that append to
# X-Forwarded-For (an AWS ALB, nginx, ...). Default 1.
# TRUSTED_PROXY_HOPS=1

# Optional request budgets (milliseconds). Defaults shown.
# API_TIMEOUT_MS=8000
# API_LOGIN_TIMEOUT_MS=20000
# API_UPLOAD_TIMEOUT_MS=60000
