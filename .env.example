# ---------------------------------------------------------------------------
# Kenzo Infosystems ERP - environment template
# Copy to .env and fill real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- URLs / ports ---
# On Render/Railway/Heroku the host injects PORT and the app binds to it;
# API_PORT is only used locally. Do not set PORT yourself in production.
API_PORT=4000
WEB_URL=http://localhost:3000

# Read by the Next.js app. Must include /api/v1 and have no trailing slash.
# It is baked in at BUILD time, so changing it on a host requires a redeploy.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# How long the web app waits for the API before showing its "unavailable"
# page. Deliberately shorter than a serverless host's own request limit, so
# a sleeping backend produces our retry page instead of the host's 504.
# Defaults shown; only set these if a slow host needs different budgets.
# API_TIMEOUT_MS=8000
# API_LOGIN_TIMEOUT_MS=20000
# API_UPLOAD_TIMEOUT_MS=60000

# --- Database (Neon PostgreSQL) ---
# Pooled connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/kenzo_erp?sslmode=require"
# Direct (non-pooled) connection used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/kenzo_erp?sslmode=require"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
AUTH_REFRESH_SECRET=replace-with-a-different-long-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d

# --- Initial super admin (seed only, change password after first login) ---
SEED_SUPERADMIN_EMAIL=admin@kenzoinfosystems.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=System Administrator

# --- Document storage ---
# Where NEW uploaded/generated files are written:
# database   = (default) inside PostgreSQL, table stored_files. Files are
#              backed up and restored together with the business records.
# local      = private folder on disk. Needs a persistent volume in production.
# cloudinary = assets stored in Cloudinary as 'authenticated' (not public).
# Files saved earlier stay readable whichever is chosen; copy them into the
# database with:  npm run storage:migrate-to-db
STORAGE_DRIVER=database

# Used only when STORAGE_DRIVER=local (and to read older local files).
STORAGE_LOCAL_ROOT=./storage

# Used only when STORAGE_DRIVER=cloudinary.
# Supply CLOUDINARY_URL on its own, OR all three of the separate values.
# Only the part from cloudinary:// onwards - not the whole "KEY=value" line
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kenzo-erp

UPLOAD_MAX_BYTES=10485760

# --- OCR ---
# stub          = no external call. Reads text files; for scans/photos it stores
#                 the file and returns an empty draft (never invents values).
# tesseract     = free engine running inside the API; reads PNG/JPEG/WEBP
#                 (not PDF). No key needed.
# google-vision = Google Cloud Vision REST API (images, PDF/TIFF first 5 pages).
#                 Requires OCR_API_KEY: a key restricted to the Vision API.
# The API refuses to start if google-vision has no key.
OCR_PROVIDER=stub
OCR_API_KEY=

# --- Outgoing email (quotation emails) ---
# Sending returns 503 until SMTP_HOST is set; the API still starts without it.
# Credentials live only in the API environment, never in the web app.
# Port 465 implies TLS; otherwise set SMTP_SECURE=true for implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Official sender. Defaults to jitender.saini@kenzoinfosystem.com when empty.
SMTP_FROM=

# --- Payment reminders ---
# An hourly in-process timer records reminders and emails customers. If the
# API process can be stopped while idle, also schedule a daily call to
#   POST /api/v1/payment-alerts/cron   with header  x-alert-token: <token>
# The endpoint is disabled (404) unless the token is at least 16 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYMENT_ALERTS_ENABLED=true
PAYMENT_ALERT_CRON_TOKEN=

# --- Client address forwarding (optional) ---
# Browsers reach the API through the Next.js server, so without this the API
# sees one address for everyone: audit logs record the web server's IP and
# all users share one rate-limit bucket. Set the SAME random value (min 32
# chars, e.g. `openssl rand -hex 32`) for the API and the web app; the web
# app then forwards the browser's IP and the API trusts it only with this
# token. Leave empty to disable. Never expose it as NEXT_PUBLIC_*.
INTERNAL_PROXY_TOKEN=

# --- Business calendar ---
# Time zone that decides "today" (default dates, today/upcoming/overdue
# follow-ups, quotation validity). API and web must use the same value.
BUSINESS_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kolkata
