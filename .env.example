# ---------------------------------------------------------------------------
# Kenzo Infosystems ERP - environment template
# Copy to .env and fill real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- URLs / ports ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Database (Neon PostgreSQL) ---
# Pooled connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/kenzo_erp?sslmode=require"
# Direct (non-pooled) connection used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/kenzo_erp?sslmode=require"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_SECRET=replace-with-a-long-random-secret
AUTH_REFRESH_SECRET=replace-with-a-different-long-random-secret
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d

# --- Initial super admin (seed only, change password after first login) ---
SEED_SUPERADMIN_EMAIL=admin@kenzoinfosystems.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=System Administrator

# --- Document storage ---
# local = private folder on disk. s3 adapter can be added without code changes elsewhere.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
UPLOAD_MAX_BYTES=10485760

# --- OCR ---
# stub          = no external call. Reads text files; for scans/photos it stores
#                 the file and returns an empty draft (never invents values).
# google-vision = Google Cloud Vision REST API (images, PDF/TIFF first 5 pages).
#                 Requires OCR_API_KEY: a key restricted to the Vision API.
# The API refuses to start if a non-stub provider has no key.
OCR_PROVIDER=stub
OCR_API_KEY=
